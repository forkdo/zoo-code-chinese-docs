{"position":[[9,3],[13,4],[22,5],[31,3],[35,5],[41,4]]}}}],["ai",{"_index":14,"t":{"696":{"position":[[16,2]]},"710":{"position":[[15,2]]},"720":{"position":[[18,3],[28,2]]},"728":{"position":[[84,2]]}}}],["approv",{"_index":18,"t":{"696":{"position":[[67,8]]}}}],["architect",{"_index":22,"t":{"728":{"position":[[37,9]]}}}],["ask",{"_index":21,"t":{"728":{"position":[[27,3]]}}}],["assist",{"_index":25,"t":{"728":{"position":[[87,9]]}}}],["code",{"_index":1,"t":{"669":{"position":[[4,4]]},"696":{"position":[[4,4]]},"710":{"position":[[4,4],[39,4]]},"720":{"position":[[4,4]]},"728":{"position":[[4,4],[16,4]]}}}],["command",{"_index":16,"t":{"696":{"position":[[43,7]]}}}],["context",{"_index":2,"t":{"669":{"position":[[9,7]]}}}],["debug",{"_index":23,"t":{"728":{"position":[[53,5]]}}}],["execut",{"_index":17,"t":{"696":{"position":[[51,10]]}}}],["file",{"_index":5,"t":{"669":{"position":[[39,4]]},"696":{"position":[[26,4]]}}}],["folder",{"_index":7,"t":{"669":{"position":[[56,6]]}}}],["git",{"_index":11,"t":{"669":{"position":[[108,3]]}}}],["integr",{"_index":12,"t":{"669":{"position":[[112,11]]}}}],["mention",{"_index":3,"t":{"669":{"position":[[17,9],[29,9],[63,9],[98,9]]}}}],["mode",{"_index":20,"t":{"728":{"position":[[9,6],[21,5],[31,5],[47,5],[59,5],[78,5],[97,6],[104,4]]}}}],["oper",{"_index":15,"t":{"696":{"position":[[31,11]]}}}],["orchestr",{"_index":24,"t":{"728":{"position":[[65,12]]}}}],["panel",{"_index":9,"t":{"669":{"position":[[82,6]]}}}],["problem",{"_index":8,"t":{"669":{"position":[[73,8]]}}}],["refer",{"_index":6,"t":{"669":{"position":[[44,11]]}}}],["switch",{"_index":26,"t":{"728":{"position":[[109,9]]}}}],["termin",{"_index":10,"t":{"669":{"position":[[89,8]]}}}],["tool",{"_index":13,"t":{"696":{"position":[[9,6],[19,6],[62,4]]}}}],["vs",{"_index":19,"t":{"710":{"position":[[36,2]]}}}],["zoo",{"_index":0,"t":{"669":{"position":[[0,3]]},"696":{"position":[[0,3]]},"710":{"position":[[0,3]]},"720":{"position":[[0,3]]},"728":{"position":[[0,3]]}}}]],"pipeline":["stemmer"]}},{"documents":[{"i":670,"t":"上下文提及是一种强大的方式，可以为 Zoo Code 提供关于项目的特定信息，使其能够更准确、高效地执行任务。您可以使用提及来引用文件、文件夹、问题以及 Git 提交。上下文提及以 @ 符号开头。 上下文提及概览，展示了聊天界面中的 @ 符号下拉菜单。","s":"上下文提及","u":"/basic-usage/context-mentions","h":"","p":669},{"i":672,"t":"文件提及将实际代码内容添加到对话中，以便直接引用和分析。 提及类型 格式 描述 使用示例 文件 @/path/to/file.ts 在请求上下文中包含文件内容 \"解释 @/src/utils.ts 中的函数\" 图像 @/path/to/image.png 将图像作为内联视觉内容包含（支持视觉处理的文件提及） \"这个 UI 有什么问题？@/screenshots/bug.png\" 文件夹 @/path/to/folder/ 包含文件夹内所有文件的内容（非递归） \"分析 @/src/components/ 中的代码\" 问题 @problems 包含 VS Code 问题面板的诊断信息 \"@problems 修复我代码中的所有错误\" 终端 @terminal 包含最近的终端命令和输出 \"修复 @terminal 中显示的错误\" Git 提交 @a1b2c3d 通过哈希引用特定提交 \"提交 @a1b2c3d 有什么变化？\" Git 更改 @git-changes 显示未提交的更改 \"为 @git-changes 建议一条消息\" URL @https://example.com 导入网站内容 \"总结 @https://docusaurus.io/\" 斜杠命令 /<command-name> 执行斜杠命令（使用 / 而非 @） \"/test 运行所有测试\"","s":"提及类型","u":"/basic-usage/context-mentions","h":"#提及类型","p":669},{"i":674,"t":"文件提及将源代码与行号结合，以便精确引用。 功能 详情 格式 @/path/to/file.ts（始终从工作区根目录以 / 开头） 提供 包含行号的完整文件内容 支持 文本文件、PDF 和 DOCX 文件（支持文本提取） 适用场景 初始请求、反馈响应和后续消息 限制 非常大的文件可能会被截断；不支持二进制文件","s":"文件提及","u":"/basic-usage/context-mentions","h":"#文件提及","p":669},{"i":676,"t":"图像提及是具备特殊视觉处理的文件提及。当您提及图像文件且模型支持视觉功能时，图像会作为内联视觉内容发送，而不是文本。 功能 详情 类型 文件提及的子类型（并非独立的提及类型） 格式 @/path/to/image.png（与文件提及相同的路径格式） 提供 图像作为内联视觉内容发送给模型 支持 PNG、JPG、JPEG、GIF、BMP、SVG、WEBP、ICO、AVIF 最佳用途 UI 审查、截图调试、图表分析 要求 需要支持视觉功能的模型（非视觉模型无法解释图像）","s":"图像提及","u":"/basic-usage/context-mentions","h":"#图像提及","p":669},{"i":678,"t":"文件夹提及包含指定目录内所有文件的内容。 功能 详情 格式 @/path/to/folder/（需要尾随斜杠以区别于文件提及） 提供 目录内所有文件的完整内容 包含 文件夹内非二进制文本文件的内容（非递归） 最佳用途 提供目录中多个文件的上下文 提示 提及大型目录时，请注意上下文窗口限制","s":"文件夹提及","u":"/basic-usage/context-mentions","h":"#文件夹提及","p":669},{"i":680,"t":"问题提及直接从 VS Code 的问题面板导入诊断信息。 功能 详情 格式 @problems 提供 VS Code 问题面板中的所有错误和警告 包含 文件路径、行号和诊断消息 分组 问题按文件组织，以提高清晰度 最佳用途 无需手动复制即可修复错误 有关 Zoo Code 如何与 VSCode 的诊断系统集成的详细信息，请参阅诊断集成。","s":"Problems Mention","u":"/basic-usage/context-mentions","h":"#problems-mention","p":669},{"i":682,"t":"终端提及捕获最近的命令输出，用于调试和分析。 功能 详情 格式 @terminal 捕获 最后一个命令及其完整输出 保留 终端状态（不会清除终端） 限制 仅限于可见的终端缓冲区内容 最佳用途 调试构建错误或分析命令输出","s":"终端提及","u":"/basic-usage/context-mentions","h":"#终端提及","p":669},{"i":684,"t":"Git 提及提供提交详情和差异，以便进行上下文感知的版本分析。 类型 格式 提供 限制 提交 @a1b2c3d 提交消息、作者、日期和完整差异 仅在 Git 仓库中有效 工作更改 @git-changes git status 输出和未提交更改的差异 仅在 Git 仓库中有效","s":"Git 提及","u":"/basic-usage/context-mentions","h":"#git-提及","p":669},{"i":686,"t":"URL 提及导入外部网页内容并将其转换为可读的 Markdown 格式。 功能 详情 格式 @https://example.com 处理 使用无头浏览器获取内容 清理 移除脚本、样式和导航元素 输出 将内容转换为 Markdown 以提高可读性 限制 复杂页面可能无法完美转换","s":"URL 提及","u":"/basic-usage/context-mentions","h":"#url-提及","p":669},{"i":688,"t":"斜杠命令由提及系统处理，但使用 / 前缀而非 @。它们执行预定义的命令以执行特定操作。 功能 详情 格式 /<command-name>（使用 / 而非 @） 提供 执行指定命令并包含相关上下文 内容类型 作为内容块类型 \"command\" 处理 示例 /test、/init、/deploy 以及其他自定义命令 最佳用途 快速访问预定义的工作流和操作 有关可用斜杠命令以及如何创建自定义命令的详细信息，请参阅斜杠命令。","s":"斜杠命令提及","u":"/basic-usage/context-mentions","h":"#斜杠命令提及","p":669},{"i":690,"t":"在聊天输入中键入 @ 以触发建议下拉菜单 继续键入以过滤建议，或使用方向键导航 使用 Enter 键或鼠标点击选择 在请求中组合多个提及：\"修复 @/src/component.ts 中的 @problems\" 下拉菜单会自动建议： 最近打开的文件 可见的文件夹 最近的 Git 提交 特殊关键字（problems、terminal、git-changes） 所有当前打开的文件（无论忽略设置或目录过滤器如何） 默认情况下，下拉菜单会遵循 .rooignore，隐藏被忽略的文件。启用 showRooIgnoredFiles 设置以在下拉菜单中包含被忽略的文件（它们将显示 🔒 指示器）。常见目录（如 node_modules、.git、dist 和 out）也会被过滤，以减少干扰。","s":"如何使用提及","u":"/basic-usage/context-mentions","h":"#如何使用提及","p":669},{"i":693,"t":"行为 说明 下拉筛选 @ 下拉菜单默认隐藏与 .rooignore 匹配的文件。启用 showRooIgnoredFiles 可查看这些文件（标记为 🔒）。 绕过 .rooignore 文件和文件夹的 @mentions 在获取上下文内容时会绕过 .rooignore 检查。如果直接提及被忽略的文件，其内容将被包含。 绕过 .gitignore 类似地，文件和文件夹的 @mentions 在获取内容时不遵循 .gitignore 规则。 遵循 Git 命令 与 Git 相关的提及（@git-changes、@commit-hash）会遵循 .gitignore，因为它们依赖 Git 命令。","s":"忽略文件交互","u":"/basic-usage/context-mentions","h":"#忽略文件交互","p":669},{"i":695,"t":"诊断集成 - 了解自动错误检测和智能严重性筛选 代码操作 - 探索编辑器中的快速修复和 AI 辅助功能 Shell 集成 - 了解终端提及如何与 Shell 集成协同工作","s":"相关功能","u":"/basic-usage/context-mentions","h":"#相关功能","p":669},{"i":697,"t":"Zoo Code 使用工具与您的代码和环境进行交互。这些专门的助手程序执行特定操作，例如读取文件、进行编辑、运行命令或搜索代码库。工具为常见开发任务提供自动化功能，无需手动执行。","s":"工具工作原理","u":"/basic-usage/how-tools-work","h":"","p":696},{"i":699,"t":"用自然语言描述您想要完成的任务，Zoo Code 将： 根据您的请求选择合适的工具 向工具展示其参数供您审核 执行已批准的工具并显示结果 继续此过程，直到您的任务完成","s":"工具工作流程","u":"/basic-usage/how-tools-work","h":"#工具工作流程","p":696},{"i":701,"t":"类别 用途 工具名称 读取 访问文件内容和代码结构 read_file、search_files、list_files、codebase_search、read_command_output 编辑 创建或修改文件和代码 write_to_file、apply_diff、apply_patch、edit、edit_file、search_replace 执行 运行命令和执行系统操作 execute_command 图像 生成 AI 驱动的图像 generate_image 工作流 管理任务流程和上下文 ask_followup_question、attempt_completion、switch_mode、new_task、skill","s":"工具类别","u":"/basic-usage/how-tools-work","h":"#工具类别","p":696},{"i":703,"t":"以下是典型工具交互的工作方式： 工具审批界面显示保存/拒绝按钮和自动批准选项。 用户： 创建一个名为 greeting.js 的文件，用于记录问候消息 Zoo Code：（如上图中所示，建议使用 write_to_file 工具） <write_to_file> <path>greeting.js</path> <content> function greet(name) { console.log(`Hello, ${name}!`); } greet('World'); </content> <line_count>5</line_count> </write_to_file> 用户：（点击界面中的“保存”按钮） Zoo Code：（确认文件创建）","s":"示例：使用工具","u":"/basic-usage/how-tools-work","h":"#示例使用工具","p":696},{"i":705,"t":"每次使用工具都需要您的明确批准。当 Zoo 建议使用某个工具时，您将看到： “保存”按钮，用于批准并执行该工具 “拒绝”按钮，用于拒绝建议的工具 可选的“自动批准”设置，用于可信操作 这种安全机制确保您对哪些文件被修改、执行哪些命令以及代码库如何更改保持控制。在保存工具建议之前，请始终仔细审核。","s":"工具安全性与审批","u":"/basic-usage/how-tools-work","h":"#工具安全性与审批","p":696},{"i":707,"t":"工具名称 描述 类别 read_file 读取文件内容并显示行号 读取 search_files 在文件中搜索文本或正则表达式模式 读取 list_files 列出指定位置的文件和目录 读取 codebase_search 在已建立索引的代码库中进行语义搜索 读取 read_command_output 检索之前命令中被截断的输出 读取 write_to_file 创建新文件或覆盖现有文件 编辑 apply_diff 对文件的特定部分进行精确更改 编辑 apply_patch 应用多文件统一 diff 补丁 编辑 edit 搜索并替换（默认首个匹配项） 编辑 edit_file 搜索并替换（所有匹配项并校验数量） 编辑 search_replace 搜索并替换（所有匹配项，简单） 编辑 execute_command 在 VS Code 终端中运行命令 执行 generate_image 根据文本提示生成 AI 驱动的图像 图像 ask_followup_question 向您提出澄清问题 工作流 attempt_completion 表示任务已完成 工作流 switch_mode 切换到不同的操作模式 工作流 new_task 创建具有特定起始模式的新子任务 工作流 skill 加载并执行预定义的技能指令 工作流","s":"核心工具参考","u":"/basic-usage/how-tools-work","h":"#核心工具参考","p":696},{"i":709,"t":"有关每个工具的更多详细信息，包括完整的参数参考和高级使用模式，请参阅工具使用概览文档。","s":"了解更多关于工具的信息","u":"/basic-usage/how-tools-work","h":"#了解更多关于工具的信息","p":696},{"i":711,"t":"Zoo Code 聊天界面是您与它交互的主要方式。它位于 Zoo Code 面板中，您可以通过点击 VS Code 活动栏中的 Zoo Code 图标 () 来打开该面板。","s":"聊天界面","u":"/basic-usage/the-chat-interface","h":"","p":710},{"i":713,"t":"聊天界面包含以下主要元素： 聊天历史记录： 该区域显示您与 Zoo Code 之间的对话历史。它会显示您的请求、Zoo Code 的回复以及任何已执行的操作（如文件编辑或命令执行）。 输入框： 这是您为 Zoo Code 输入任务和问题的地方。您可以使用简单的英语进行交流。 操作按钮： 这些按钮出现在输入框上方，允许您批准或拒绝 Zoo Code 提出的操作。可用按钮会根据上下文而变化。 发送按钮： 它看起来像一个小飞机，位于输入框的最右侧。在您输入消息后，点击此按钮即可将消息发送给 Zoo。 加号按钮： 加号按钮位于顶部的标题栏中。它会切换到聊天标签页并聚焦到输入框。要重置会话、开始新任务或清除当前任务，请使用此按钮。 设置按钮： 设置按钮是一个齿轮图标，用于打开设置以自定义功能或行为。 模式选择器： 模式选择器是一个下拉菜单，位于聊天输入框的左侧。它用于选择 Zoo 应为您的任务使用哪种模式。其设置齿轮会打开“模式”标签页，而非通用设置。 编号界面元素展示了 Zoo Code 聊天界面的关键组件。","s":"聊天界面的组成部分","u":"/basic-usage/the-chat-interface","h":"#聊天界面的组成部分","p":710},{"i":715,"t":"为了获得更好的工作流程，您可以将 Zoo Code 拖拽到 VS Code 的辅助侧边栏。这样可以在保持 Zoo Code 可见的同时，仍能访问主侧边栏中的资源管理器、搜索、源代码控制和其他面板。 设置方法如下： 点击并拖拽活动栏中的 Zoo Code 图标 将其拖放到编辑器右侧以创建辅助侧边栏 现在您可以同时使用两个侧边栏了！ 如需更多效率技巧，请查看我们的技巧与窍门指南。","s":"提示：使用辅助侧边栏","u":"/basic-usage/the-chat-interface","h":"#提示使用辅助侧边栏","p":710},{"i":717,"t":"可点击链接： 聊天历史记录中的文件路径、URL 和其他提及内容都是可点击的。点击文件路径将在编辑器中打开该文件。点击 URL 将在您的默认浏览器中打开它。 复制文本： 您可以通过选中文本并使用标准复制命令（Ctrl/Cmd + C）从聊天历史记录中复制文本。某些元素（如代码块）还配有专用的“复制”按钮。 展开和折叠： 点击消息可将其展开或折叠。","s":"与消息交互","u":"/basic-usage/the-chat-interface","h":"#与消息交互","p":710},{"i":719,"t":"加载指示器： 当 Zoo Code 正在处理请求时，您会看到一个加载指示器。 错误消息： 如果发生错误，将显示红色错误消息。 成功消息： 绿色消息表示操作已成功完成。","s":"状态指示器","u":"/basic-usage/the-chat-interface","h":"#状态指示器","p":710},{"i":721,"t":"Zoo Code 旨在理解自然语言。您无需使用任何特殊命令或语法即可与它通信。只需用简单的英文输入您的请求，就像在与人类开发者交谈一样。","s":"输入您的请求","u":"/basic-usage/typing-your-requests","h":"","p":720},{"i":723,"t":"明确说明您希望 Zoo Code 做什么。避免使用模糊或含糊不清的语言。 策略 实现方式 具体明确 \"修复 calculateTotal 中返回错误结果的 bug\" 而不是 \"修复代码\" 提供上下文 使用 @ 上下文提及 进行文件和代码引用 分解任务 将复杂任务以较小的可管理步骤提交 包含示例 需要特定格式或样式时提供示例代码","s":"有效的请求策略","u":"/basic-usage/typing-your-requests","h":"#有效的请求策略","p":720},{"i":725,"t":"create a new file named `utils.py` and add a function called `add` that takes two numbers as arguments and returns their sum in the file @src/components/Button.tsx, change the color of the button to blue find all instances of the variable `oldValue` in @/src/App.js and replace them with `newValue` run the command `npm install` in the terminal explain the function `calculateTotal` in @/src/utils.ts @problems address all detected problems","s":"请求示例","u":"/basic-usage/typing-your-requests","h":"#请求示例","p":720},{"i":727,"t":"不要 要 模糊的请求 明确说明需要做什么 假设上下文 明确引用文件和函数 过度的技术术语 使用清晰、直接的语言 多个不相关的任务 一次提交一个集中的请求 未经确认就继续 检查代码以确保已完成","s":"需要避免的常见陷阱","u":"/basic-usage/typing-your-requests","h":"#需要避免的常见陷阱","p":720},{"i":729,"t":"Zoo Code 中的模式是专门的“人设”，可根据你当前的任务调整助手行为。每种模式都提供不同的能力、专业知识和访问级别，帮助你实现特定目标。 粘性模型与模式持久化 每种模式都会记住你上次使用的模型。切换模式时，Zoo 会自动选择该模型——无需手动选择。为不同模式分配不同模型（例如，为 🏗️ Architect 模式分配 Gemini 2.5 Preview，为 💻 Code 模式分配 Claude Sonnet 3.7），当你切换模式时，Zoo 会自动切换模型。 此外，你选择的模式会在会话之间保持——Zoo 会记住你返回时正在使用的模式。","s":"使用模式","u":"/basic-usage/using-modes","h":"","p":728},{"i":731,"t":"任务专业化： 为你当前的任务获取精确类型的辅助 安全控制： 在专注于规划或学习时防止意外的文件修改 专注交互： 接收针对你当前活动优化的响应 工作流优化： 在规划、实现、调试和学习之间无缝过渡","s":"为什么要使用不同的模式？","u":"/basic-usage/using-modes","h":"#为什么要使用不同的模式","p":728},{"i":733,"t":"四种切换模式的方式： 下拉菜单： 点击聊天输入框左侧的选择器 斜杠命令： 在消息开头输入 /architect、/ask、/debug、/code 或 /orchestrator。这将切换到该模式并清空输入字段。 切换命令/键盘快捷键： 使用适用于你操作系统的键盘快捷键。每次按键会按顺序循环切换可用模式，到达末尾后回到第一种模式。 操作系统 快捷键 macOS ⌘ + . Windows Ctrl + . Linux Ctrl + . 接受建议： 点击 Zoo 在适当时提供的模式切换建议","s":"Switching Between Modes","u":"/basic-usage/using-modes","h":"#switching-between-modes","p":728},{"i":736,"t":"方面 详情 名称 💻 Code 描述 一名熟练的软件工程师，具备编程语言、设计模式和最佳实践经验 工具访问 完全访问所有工具组：read、edit、command、mcp 适用场景 编写代码、实现功能、调试和一般开发 特殊功能 无工具限制——所有编码任务都具有完全灵活性","s":"Code Mode (Default)","u":"/basic-usage/using-modes","h":"#code-mode-default","p":728},{"i":738,"t":"方面 详情 名称 ❓ Ask 描述 一名知识渊博的技术助手，专注于提供全面完整的答案。除非明确要求，否则不太倾向于切换到实现代码，并可能使用图表进行澄清。 工具访问 有限访问：仅 read、mcp（无法编辑文件或运行命令） 适用场景 代码解释、概念探索和技术学习 特殊功能 针对详细、信息丰富的响应进行了优化，通常使用图表提高清晰度，而不会修改你的项目。","s":"Ask 模式","u":"/basic-usage/using-modes","h":"#ask-模式","p":728},{"i":740,"t":"方面 详情 名称 🏗️ Architect 描述 一名经验丰富的技术领导者和规划师，帮助设计系统和创建实施计划 工具访问 访问 read、mcp 和受限的 edit（仅限 markdown 文件） 适用场景 系统设计、高层规划和架构讨论 特殊功能 遵循从信息收集到详细规划的结构化方法","s":"Architect Mode","u":"/basic-usage/using-modes","h":"#architect-mode","p":728},{"i":742,"t":"方面 详情 名称 🪲 Debug 描述 一名专业的故障排除专家，专注于系统性故障排查和诊断 工具访问 完全访问所有工具组：read、edit、command、mcp 适用场景 追踪 bug、诊断错误和解决复杂问题 特殊功能 采用分析、缩小可能性范围和修复问题的方法论方法。包含自定义指令以反映、提炼可能性、添加日志并在修复前确认。","s":"Debug Mode","u":"/basic-usage/using-modes","h":"#debug-mode","p":728},{"i":744,"t":"方面 详情 名称 🪃 Orchestrator 描述 一名战略性工作流编排器（又名 Boomerang 模式），可将复杂任务分解并委派给专门的模式。了解更多关于 Boomerang 任务 的信息。 工具访问 无直接工具访问（使用 new_task 工具将工作委派给其他模式） 适用场景 管理多步骤项目、协调不同模式间的工作和自动化复杂工作流 特殊功能 使用 new_task 工具将子任务委派给其他模式。","s":"Orchestrator Mode (aka Boomerang Mode)","u":"/basic-usage/using-modes","h":"#orchestrator-mode-aka-boomerang-mode","p":728},{"i":746,"t":"通过自定义现有模式或创建新的专门助手来调整 Zoo Code 的行为。定义工具访问、文件权限和行为指令以执行团队标准或创建特定用途的助手。有关设置说明，请参阅 自定义模式文档。","s":"自定义模式","u":"/basic-usage/using-modes","h":"#自定义模式","p":728},{"i":748,"t":"每个工具组提供特定能力： read：文件读取、列出和搜索能力 edit：文件修改和创建能力 command：终端命令执行 mcp：模型上下文协议服务器交互 有关可用工具的详细信息，请参阅 可用工具文档。","s":"了解工具组","u":"/basic-usage/using-modes","h":"#了解工具组","p":728}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/670",[0,0.076,1,1.145,2,1.07,3,2.397]],["t/672",[0,0.077,2,0.435,3,2.336,4,1.363,5,1.363,6,1.363,7,1.363,8,1.615,9,1.363,10,1.615,11,1.756,12,0.976,13,1.958,14,2.229,15,1.756,16,1.198,17,1.363,18,1.615,19,1.074,20,1.074,21,1.615]],["t/674",[0,0.078,4,2.834,22,3.356,23,3.356]],["t/676",[0,0.078,6,2.964,7,2.964,24,3.51]],["t/678",[0,0.078,9,3.184]],["t/680",[0,0.077,1,0.856,2,1.317,11,1.972,12,2.54,25,2.964]],["t/682",[0,0.078,13,2.798]],["t/684",[0,0.076,3,3.467,14,2.658,15,2.095,26,3.148]],["t/686",[0,0.078,16,2.49,17,2.834,27,3.87]],["t/688",[0,0.078,19,2.797,20,1.972,28,2.964]],["t/690",[0,0.077,3,1.633,11,1.798,15,1.798,29,2.702,30,2.702,31,2.7